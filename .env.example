# Private audio file directory, relative to the project root.
AUDIO_STORAGE_PATH=storage/audio

# Application-level audio file limit.
MAX_AUDIO_FILE_SIZE_MB=50

# Adapter Node request limit, kept above the file limit for multipart overhead.
BODY_SIZE_LIMIT=55M

# HttpOnly authentication cookie settings.
SESSION_COOKIE_NAME=audio_library_session
SESSION_DURATION_DAYS=7

# MongoDB is the only persistence backend. Use a transaction-capable replica set.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=audio_library_dev
MONGODB_TEST_DB_NAME=audio_library_test_local

# MongoDB Atlas alternative. Replace placeholders only in your untracked .env.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
# MONGODB_DB_NAME=audio_library_dev
# MONGODB_TEST_DB_NAME=audio_library_test_atlas
