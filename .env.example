# Private media storage root, relative to the project root.
# Audio files remain at this root; optional cover images use its covers/ subdirectory.
AUDIO_STORAGE_PATH=storage/audio

# Application-level audio file limit.
MAX_AUDIO_FILE_SIZE_MB=80

# Application-level optional JPEG, PNG, or WebP cover-image limit.
COVER_IMAGE_MAX_SIZE_MB=5

# Separate private storage and upload limit for owner-only playlist artwork.
PLAYLIST_IMAGE_STORAGE_PATH=storage/playlist-images
PLAYLIST_IMAGE_MAX_SIZE_MB=5

# Adapter Node request limit. It must cover the larger request shape: audio plus
# track cover, or playlist image, plus 1 MiB of multipart/form-data overhead.
BODY_SIZE_LIMIT=90M

# HttpOnly authentication cookie settings.
SESSION_COOKIE_NAME=audio_library_session
SESSION_DURATION_DAYS=7

# MongoDB is the only persistence backend. Use a transaction-capable replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=audio_library_dev
MONGODB_TEST_DB_NAME=audio_library_test_local

# Explicit private backup roots. Prefer roots on a separate protected disk.
MONGODB_BACKUP_ROOT=.backups/mongodb
AUDIO_BACKUP_ROOT=.backups/audio

# Production adapter-node runtime (use the actual HTTPS public origin).
# HOST=127.0.0.1
# PORT=3000
# ORIGIN=https://audio.example.test
