# Path to the local SQLite database, relative to the project root.
DATABASE_URL=./data/app.db

# Private audio file directory, relative to the project root.
AUDIO_STORAGE_PATH=storage/audio

# Application-level audio file limit.
MAX_AUDIO_FILE_SIZE_MB=50

# Adapter Node request limit, kept above the file limit for multipart overhead.
BODY_SIZE_LIMIT=55M

# HttpOnly authentication cookie settings.
SESSION_COOKIE_NAME=audio_library_session
SESSION_DURATION_DAYS=7
