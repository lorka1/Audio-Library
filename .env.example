# private media storage root relative to the project root
# audio files stay at this root; optional cover images use its covers/ subdirectory
AUDIO_STORAGE_PATH=storage/audio

# application audio file limit
MAX_AUDIO_FILE_SIZE_MB=80

# optional JPEG, PNG, or WebP cover image limit
COVER_IMAGE_MAX_SIZE_MB=5

# separate private storage and upload limit for owner-only playlist artwork
PLAYLIST_IMAGE_STORAGE_PATH=storage/playlist-images
PLAYLIST_IMAGE_MAX_SIZE_MB=5

# adapter-node request limit covering the larger upload shape: audio plus
# a track cover or playlist image, plus 1 MiB of multipart/form-data overhead
BODY_SIZE_LIMIT=90M

# settings for HttpOnly authentication cookies
SESSION_COOKIE_NAME=audio_library_session
SESSION_DURATION_DAYS=7

# use MongoDB as the only persistence backend with a transaction-capable replica set
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=audio_library_dev

# production adapter-node runtime using the actual HTTPS public origin
# HOST=127.0.0.1
# PORT=3000
# ORIGIN=https://audio.example.test
